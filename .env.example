# Hub internals
DATABASE_URL=sqlite+aiosqlite:///./data/hub.db
REDIS_URL=redis://redis:6379/0

# LLM
LLM_MODEL=openai/coding
LLM_ENABLED=true
LLM_API_BASE=http://localhost:20128/v1
OPENAI_API_KEY=your-api-key-here

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# WhatsApp (Evolution API)
WHATSAPP_API_URL=http://evolution:8080
WHATSAPP_API_KEY=your-evolution-api-key-here
WHATSAPP_INSTANCE=hub

# Logging
LOG_LEVEL=INFO
TELEGRAM_CHAT_ID=your-chat-id-here
